# ── Server wallet ────────────────────────────────────────────────────────────
# EVM address that receives USDC payments (your wallet)
EVM_ADDRESS=0xYOUR_EVM_WALLET_ADDRESS

# ── Network ───────────────────────────────────────────────────────────────────
# Base Sepolia testnet (switch to eip155:8453 for Base mainnet)
EVM_NETWORK=eip155:84532

# ── Facilitator ───────────────────────────────────────────────────────────────
# Testnet: https://x402.org/facilitator
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_URL=https://x402.org/facilitator

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4021

# ── Agent client (only needed when running client_example.py) ─────────────────
# Private key of the agent's wallet that pays for API calls
AGENT_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY
