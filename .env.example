# ── Seller wallet ────────────────────────────────────────────────────────────
# EVM address of the seller (receives payouts after fee deduction)
EVM_ADDRESS=0xYOUR_SELLER_WALLET_ADDRESS

# ── Platform wallet ───────────────────────────────────────────────────────────
# EVM address that collects ALL payments (platform takes cut, pays out sellers)
PLATFORM_WALLET=0xYOUR_PLATFORM_WALLET_ADDRESS

# Platform private key — used by payout.py to send USDC to sellers
PLATFORM_PRIVATE_KEY=0xYOUR_PLATFORM_PRIVATE_KEY

# Fee in basis points (100 = 1%, 50 = 0.5%, 200 = 2%)
PLATFORM_FEE_BPS=100

# ── Network ───────────────────────────────────────────────────────────────────
# Base Sepolia testnet (switch to eip155:8453 for Base mainnet)
EVM_NETWORK=eip155:84532

# ── Facilitator ───────────────────────────────────────────────────────────────
# Testnet: https://x402.org/facilitator
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_URL=https://x402.org/facilitator

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4021

# ── Agent client (only needed when running client_example.py) ─────────────────
# Private key of the agent's wallet that pays for API calls
AGENT_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY
